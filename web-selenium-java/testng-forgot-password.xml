<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Asset Sphere Forgot Password Suite" parallel="false">
    <test name="Forgot Password Tests">
        <classes>
            <class name="com.assetsphere.tests.WebAuthValidationTest">
                <methods>
                    <include name="forgotPasswordPageLoads"/>
                    <include name="forgotPasswordRequiresValidEmail"/>
                    <include name="forgotPasswordShowsErrorForStaticOtp"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
